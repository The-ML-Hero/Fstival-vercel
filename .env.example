# API Guardian - Environment Configuration

# Application
APP_NAME=API Guardian — AI-Powered API Security & Attack Simulation Platform
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_STR=/api/v1

# CORS Allowed Origins (Comma-separated or JSON list in production)
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Frontend API URL (for Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Database Configuration
# SQLite (Async): sqlite+aiosqlite:///./api_guardian.db
# PostgreSQL (Async): postgresql+asyncpg://postgres:postgres@localhost:5432/api_guardian
DATABASE_URL=sqlite+aiosqlite:///./api_guardian.db

# AI Provider Configuration
# Options: "fallback" (deterministic rule-based OWASP logic), "openai", "ollama"
AI_PROVIDER=fallback

# OpenAI Settings (when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama Settings (when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Bruno CLI Configuration
BRUNO_CLI_PATH=bru
GENERATED_COLLECTIONS_DIR=./generated

# Scoring Weights for Attack Prioritization
PRIORITY_WEIGHT_SEVERITY=0.40
PRIORITY_WEIGHT_EXPLOITABILITY=0.30
PRIORITY_WEIGHT_CONFIDENCE=0.15
PRIORITY_WEIGHT_IMPACT=0.15

# Security Guardrails
REQUIRE_TARGET_AUTHORIZATION_FOR_ANALYSIS=false
REQUIRE_TARGET_AUTHORIZATION_FOR_EXECUTION=true
MASK_SECRETS_IN_LOGS=true
